{
  "name": "@contextbridge/cli",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "bin": {
    "contextbridge": "./src/cli.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
