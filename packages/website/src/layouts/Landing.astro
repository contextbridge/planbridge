        />
      )
    }
  </head>
  <body class="m-0 bg-background text-foreground font-sans antialiased">
    <!-- Sticky nav: Context____Bridge wordmark style -->
    <header
      class="section-dark sticky top-0 z-50 flex items-center gap-4 border-b border-border bg-background px-6 py-5 sm:px-8 sm:py-6"
    >
      <a href="/" class="inline-flex flex-1 items-center gap-3 text-foreground no-underline">
        <svg
          aria-hidden="true"
          fill="currentColor"
          viewBox="-0.348 -0.445 151 164"
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 sm:h-6 sm:w-6"
        >
          <path d="M127.035 43.2306L134.972 0H21.973L0 119.88H23.2335L37.303 43.2306H127.035Z"></path>
          <path d="M127.037 43.231L113.001 119.881H23.2355L15.332 163.111H128.297L150.304 43.231H127.037Z"></path>
        </svg>
        <span class="font-mono text-sm font-bold tracking-tight sm:text-base">PlanBridge</span>
      </a>
      <nav class="ml-2 flex items-center gap-4 sm:ml-8 sm:gap-8">
        <a
          href="/#data-privacy"
          class="font-mono text-sm font-medium text-foreground no-underline hover:underline sm:text-base"
          ><span class="hidden sm:inline">Data </span>Privacy</a
        >
        <a href="/#faq" class="font-mono text-sm font-medium text-foreground no-underline hover:underline sm:text-base"
          >FAQ</a
        >
        <a
          href="/quickstart/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm font-medium text-foreground no-underline hover:underline sm:text-base">Docs</a
        >
        <a
          href="https://github.com/contextbridge/planbridge"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View source on GitHub"
          class="hidden items-center text-foreground no-underline sm:inline-flex"
        >
          <Icon name="simple-icons:github" class="h-6 w-6" />
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-foreground px-8 py-16">
      <div class="mx-auto flex max-w-7xl flex-col gap-8 font-mono text-base text-foreground">
        <div class="flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
          <div class="flex flex-col gap-2 font-sans text-base text-foreground">
            <p class="m-0 flex flex-wrap items-center gap-x-4 gap-y-2">
              <span class="font-mono text-base font-bold">PlanBridge</span>
              <a href="https://contextbridge.ai" class="text-foreground no-underline hover:underline"
                >by ContextBridge</a
              >
            </p>
            <p class="m-0">
              Join the
              <a
                href="https://tasteintheloop.ai/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-foreground underline underline-offset-4"
                ><Image
                  src={tasteInTheLoopBadge}
                  alt=""
                  aria-hidden="true"
                  width={16}
                  height={16}
                  layout="none"
                  class="mr-1 inline-block h-[0.9em] w-[0.9em] rounded-[0.2em] align-[-0.14em]"
                />Taste in the Loop</a
              >
              movement.
            </p>
          </div>
          <div class="flex items-center gap-8">
            <a href="/#data-privacy" class="font-sans text-base text-foreground no-underline hover:underline"
              >Data Privacy</a
            >
            <a href="/#faq" class="font-sans text-base text-foreground no-underline hover:underline">FAQ</a>
            <a
              href="/quickstart/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-sans text-base text-foreground no-underline hover:underline">Docs</a
            >
            <a
              href="https://github.com/contextbridge/planbridge"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View source on GitHub"
              class="inline-flex items-center text-foreground"
            >
              <Icon name="simple-icons:github" class="h-6 w-6" />
            </a>
          </div>
        </div>
        <p class="m-0 pt-6 text-center font-sans text-base text-foreground">
          Made with
          <span data-made-with-emoji aria-label="coffee" role="img">☕</span>
          in
          <span aria-label="mountains" role="img">🏔️</span> Denver and
          <span aria-label="beach" role="img">🏖️</span> Santa Cruz.
        </p>
      </div>
    </footer>

    <script>
      const states = [
        { emoji: '☕', label: 'coffee' },
        { emoji: '💙', label: 'love' },
        { emoji: '🏋️', label: 'weights' },
        { emoji: '🌯', label: 'burritos' },
        { emoji: '🍕', label: 'pizza' },
        { emoji: '🍜', label: 'ramen' },
        { emoji: '🍣', label: 'sushi' },
        { emoji: '🍵', label: 'tea' },
        { emoji: '🚴', label: 'biking' },
        { emoji: '🚵', label: 'mountain biking' },
        { emoji: '🎸', label: 'guitar' },
        { emoji: '🎧', label: 'headphones' },
        { emoji: '🎲', label: 'dice' },
        { emoji: '😴', label: 'sleep' },
        { emoji: '💯', label: '100' },
        { emoji: '☀️', label: 'sun' },
        { emoji: '☁️', label: 'cloud' },
      ] as const;
      const el = document.querySelector<HTMLElement>('[data-made-with-emoji]');
      if (el) {
        const shuffle = <T,>(arr: readonly T[]): T[] => {
          const a = arr.slice();
          for (let j = a.length - 1; j > 0; j--) {
            const k = Math.floor(Math.random() * (j + 1));
            [a[j], a[k]] = [a[k]!, a[j]!];
          }
          return a;
        };
        let queue = shuffle(states);
        let i = 0;
        const apply = () => {
          const state = queue[i] ?? states[0];
          el.textContent = state.emoji;
          el.setAttribute('aria-label', state.label);
        };
        apply();
        setInterval(() => {
          i++;
          if (i >= queue.length) {
            const last = queue[queue.length - 1];
            queue = shuffle(states);
            // avoid repeating the last emoji as the first of the new cycle
            if (queue[0] === last && queue.length > 1) {
              [queue[0], queue[1]] = [queue[1]!, queue[0]!];
            }
            i = 0;
          }
          apply();
        }, 4000);
      }
    </script>
  </body>
</html>
